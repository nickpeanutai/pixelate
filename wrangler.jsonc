{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pixelate",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-10",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "pixelate.nickpeanut.com",
      "custom_domain": true
    },
    {
      "pattern": "pixelate.nickpeanutai.com",
      "custom_domain": true
    }
  ]
}

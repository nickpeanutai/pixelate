{
  "name": "pixelate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy:cloudflare": "pnpm build && wrangler deploy",
    "deploy:cloudflare:dry-run": "pnpm build && wrangler deploy --dry-run",
    "compare:pixels": "vite-node scripts/compare-pixel-pipelines.ts",
    "test": "vitest run",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "check": "tsc --noEmit && pnpm test && pnpm build"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@pixel-sprite/editor-core": "workspace:*",
    "@pixel-sprite/export-core": "workspace:*",
    "@pixel-sprite/pixel-core": "workspace:*",
    "@pixel-sprite/project-schema": "workspace:*",
    "@vitejs/plugin-react": "5.0.4",
    "gifenc": "^1.0.3",
    "jszip": "^3.10.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "fake-indexeddb": "^6.2.5",
    "pngjs": "^7.0.0",
    "typescript": "^5.9.3",
    "vite-node": "^6.0.0",
    "vitest": "^3.2.4",
    "wrangler": "^4.92.0"
  }
}
